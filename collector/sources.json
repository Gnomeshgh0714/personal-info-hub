{
  "版本": "1.1",
  "说明": "demo 配置：四条源全部指向 examples/demo-sources 下的合成示例（相对路径按仓库根解析），clone 即可跑。改成自己的源时，把「根」换成自己的目录（绝对路径，或相对仓库根的路径），按需调整扩展名白名单与提取器。采集器只认这里列出的源根，绝不整盘遍历；改本文件等于改采集范围，属人工决策。",
  "全局跳过": {
    "目录名": [
      "node_modules", ".venv", "venv", ".git", "__pycache__", ".pytest_cache",
      "99_归档", ".qoder", ".idea", ".vscode", ".mypy_cache", ".ruff_cache", "dist", "build"
    ],
    "扩展名": [".zip", ".rar", ".7z", ".gz", ".tar", ".bz2", ".env", ".aux", ".log", ".out", ".fls", ".fdb_latexmk", ".synctex", ".pyc"],
    "文件名": [".DS_Store", ".env", "Thumbs.db"],
    "单文件上限MB": 20,
    "跳过重复副本": true,
    "重复副本正则": "[（(]\\s*\\d+\\s*[)）]\\s*$",
    "说明": "重复副本指同步工具遗留的「xxx(1).ext」类同名副本，内容与正本一致，纳入只会虚增条目与新增计数，故整类跳过并单独计数。"
  },
  "二进制登记扩展名": [".pdf", ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".tiff", ".doc", ".ppt", ".pptx", ".xls", ".xlsm", ".key", ".pages", ".numbers"],
  "源清单": [
    {
      "名称": "demo-简历",
      "盘": "demo",
      "工作区": "示例工作区",
      "根": "examples/demo-sources/resume",
      "子路径": [],
      "最大深度": 1,
      "扩展名": [".tex"],
      "提取器": "resume_tex",
      "默认分类": "实习经历",
      "主源冲突组": "简历多源",
      "主源冲突文件": ["简历-求职版.tex", "简历-保研版.tex"],
      "简历场景映射": {
        "简历-求职版.tex": "求职版",
        "简历-保研版.tex": "保研版"
      },
      "主源裁决": "人工裁决：多源并存、按场景归类、不选唯一权威源；只定主源归属场景，不裁决内容真伪，状态仍为待核验",
      "场景警示规则": [
        {
          "场景含": "保研",
          "文本匹配": "排名|名次|专业前|绩点|GPA|核心课程|课程成绩|加权均分|平均分|\\brank",
          "警示": "排名仅限保研场景、禁止流入求职简历表述"
        }
      ],
      "说明": "两份合成简历按 \\resumesection / \\resumeentry / \\resumesubentry / \\item 结构拆条，节名映射到六个分类。两份主源同组，依「简历场景映射」归入求职版 / 保研版两个场景并存，不一律标「主源冲突」；映射漏配的文件名仍回退为「主源冲突」（安全阀）。保研版派生的排名/成绩类条目按「场景警示规则」自动带警示标签。"
    },
    {
      "名称": "demo-代码项目",
      "盘": "demo",
      "工作区": "示例工作区",
      "根": "examples/demo-sources/projects",
      "子路径": [],
      "最大深度": 2,
      "扩展名": [".md"],
      "仅文件名": ["README.md"],
      "提取器": "readme_oneliner",
      "默认分类": "项目经历",
      "说明": "每个代码项目只取 README 的一句话定位，不扫代码、不扫 node_modules。"
    },
    {
      "名称": "demo-获奖材料",
      "盘": "demo",
      "工作区": "示例工作区",
      "根": "examples/demo-sources/awards",
      "子路径": [],
      "最大深度": 1,
      "扩展名": [".md"],
      "提取器": "doc_auto",
      "默认分类": "获奖荣誉",
      "说明": "合成获奖记录 md，演示 doc_auto 的标题/摘要/小节抽取与数字级证据定位。真实场景里证书扫描件（pdf/jpg）可配「登记扩展名」只登记路径，状态标「需OCR人工录入」。"
    },
    {
      "名称": "demo-技能包",
      "盘": "demo",
      "工作区": "示例工作区",
      "根": "examples/demo-sources/skills",
      "子路径": [],
      "最大深度": 2,
      "扩展名": [".md"],
      "仅文件名": ["SKILL.md"],
      "提取器": "skill_registry",
      "默认分类": "技能资产",
      "说明": "技能包目录，每个只登记名称与一句话定位（SKILL.md frontmatter 的 name + description 首句），不展开 references/scripts/assets 内容。"
    }
  ]
}